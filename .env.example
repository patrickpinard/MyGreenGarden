# ============================================================
#  MyGreenGarden V7.0 — Fichier de configuration
#  Copier ce fichier en .env et remplir les valeurs
#  NE JAMAIS commiter le fichier .env dans git
# ============================================================

# --- Application ---
APP_NAME="MyGreenGarden"
SECRET_KEY="changez-cette-cle-secrete-longue-et-aleatoire"

# --- Authentification (PIN 4-6 chiffres) ---
# Générer avec : python -c "from passlib.hash import bcrypt; print(bcrypt.hash('1234'))"
PIN_HASH="$2b$12$HASH_GENERE_ICI"

# --- Base de données ---
DATABASE_URL="sqlite:///./data/mygreengarden.db"

# --- Email (SMTP) ---
SMTP_SERVER="smtpauths.bluewin.ch"
SMTP_PORT=465
SMTP_USER="votre@email.ch"
SMTP_PASSWORD="votre-mot-de-passe"
EMAIL_SENDER="votre@email.ch"
EMAIL_RECEIVER="votre@email.ch"

# --- Notifications push iOS (VAPID) ---
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:votre@email.ch"

# --- Hardware ---
# Mettre True sur Mac/PC pour tests sans Raspberry Pi
SIMULATION_MODE=False

# --- Session ---
SESSION_TIMEOUT_HOURS=24
